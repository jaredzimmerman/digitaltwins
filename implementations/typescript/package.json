{
  "name": "prsn-ts",
  "version": "0.1.0",
  "description": "Reader/writer library for the .prsn digital-twin file format (v1)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.js\"",
    "vectors": "npm run build && node dist/cli.js vectors /tmp/digitaltwins/prsn/conformance",
    "verify": "node dist/cli.js verify",
    "canon": "node dist/cli.js canon",
    "clean": "rm -rf dist dist-test"
  },
  "keywords": [],
  "author": "Jared Zimmerman",
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/curves": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "bin": {
    "prsn-ts": "dist/cli.js"
  },
  "types": "dist/index.d.ts"
}
