{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredzimmerman/digitaltwins/core/schemas/refs.schema.json",
  "title": "manifest.refs (core.md §7)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "format",
      "id"
    ],
    "properties": {
      "format": {
        "enum": [
          "prsn",
          "styl",
          "scen"
        ]
      },
      "id": {
        "type": "string",
        "pattern": "^urn:uuid:[0-9a-fA-F-]{36}$"
      },
      "manifest": {
        "$ref": "https://github.com/jaredzimmerman/digitaltwins/prsn/schemas/defs.schema.json#/$defs/contentId"
      },
      "role": {
        "type": "string",
        "minLength": 1
      },
      "label": {
        "type": "string"
      }
    },
    "additionalProperties": true
  }
}
