{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredzimmerman/digitaltwins/core/schemas/holdout.schema.json",
  "title": "Held-out split index record (core.md §5.4)",
  "type": "object",
  "required": [
    "seed",
    "items"
  ],
  "properties": {
    "seed": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://github.com/jaredzimmerman/digitaltwins/prsn/schemas/defs.schema.json#/$defs/sha256Hex"
      }
    },
    "method": {
      "type": "string"
    },
    "strata": {
      "type": "string"
    },
    "fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    }
  },
  "additionalProperties": true
}
