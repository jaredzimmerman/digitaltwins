{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredzimmerman/digitaltwins/core/schemas/captions.schema.json",
  "title": "Captions index record (core.md §5.1)",
  "description": "Per-sample training captions in one convention. Every item names a samples/ or training/ entry of the same file by sha256 (checked by the validator).",
  "type": "object",
  "required": [
    "convention",
    "excludes",
    "items"
  ],
  "properties": {
    "convention": {
      "type": "string",
      "pattern": "^(natural|tags|[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,})$"
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "excludes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "identity",
          "style",
          "place",
          "prop"
        ]
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sha256",
          "text"
        ],
        "properties": {
          "sha256": {
            "$ref": "https://github.com/jaredzimmerman/digitaltwins/prsn/schemas/defs.schema.json#/$defs/sha256Hex"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
