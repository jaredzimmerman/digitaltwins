{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredzimmerman/digitaltwins/prsn/schemas/script.schema.json",
  "title": ".prsncap script/script.json",
  "description": "The capture plan: phase ids and modes are fixed; prompts and timings are versioned content (spec/prsncap.md section 7).",
  "type": "object",
  "required": ["id", "version", "kind", "phases"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"$ref": "session.schema.json#/$defs/scriptKind"},
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["avf", "arkit", "rear"]},
          "steps": {"type": "array", "items": {"type": "string"}},
          "optional": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "global": {"type": "object"}
  },
  "additionalProperties": true
}
