{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredzimmerman/digitaltwins/prsn/schemas/person.schema.json",
  "title": ".prsn person.json",
  "description": "Who the file is about, in the current shape (writers always write this shape). Contains no biometrics. Other fields are allowed. Readers map the legacy shape (`name`, `ids` object, `links` object) to this one before validating (spec/prsn.md, person.json).",
  "type": "object",
  "required": [
    "id",
    "display_name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "href"
        ],
        "properties": {
          "rel": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scheme",
          "value"
        ],
        "properties": {
          "scheme": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "kind": {
      "enum": [
        "real",
        "fictional"
      ],
      "description": "spec >= 1.2. Absent means `real`. A fictional person may hold `authored` material (core.md §4)."
    },
    "rights": {
      "type": "object",
      "description": "Who owns a fictional character (holder, licence).",
      "properties": {
        "holder": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "consent": {
      "type": "object",
      "description": "Remote-processing consent for material not tied to a capture session (core.md §6.3). `cloud_families` as in session.json; `vendors` lists vendor names allowed to receive samples.",
      "properties": {
        "cloud_families": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vendors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
