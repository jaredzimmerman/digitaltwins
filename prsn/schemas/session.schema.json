{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredzimmerman/digitaltwins/prsn/schemas/session.schema.json",
  "title": ".prsncap session.json",
  "description": "The session record of a capture (spec/prsncap.md section 4). Critical: a reader that cannot read it refuses the capture.",
  "type": "object",
  "required": [
    "format",
    "version",
    "session_id",
    "started",
    "tier",
    "script",
    "clock",
    "devices",
    "streams",
    "phases",
    "capabilities"
  ],
  "properties": {
    "format": {
      "const": "prsncap"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^urn:uuid:"
    },
    "person_ref": {
      "type": "string",
      "pattern": "^urn:uuid:"
    },
    "started": {
      "$ref": "defs.schema.json#/$defs/dateTime"
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "tier": {
      "$ref": "#/$defs/tier"
    },
    "derived_from": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "manifest_sha256",
            "recipe",
            "action_key"
          ],
          "properties": {
            "manifest_sha256": {
              "$ref": "defs.schema.json#/$defs/sha256OrContentId"
            },
            "recipe": {
              "type": "object",
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "$ref": "defs.schema.json#/$defs/recordType"
                },
                "version": {
                  "type": "string"
                }
              }
            },
            "action_key": {
              "$ref": "defs.schema.json#/$defs/contentId"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "script": {
      "$ref": "#/$defs/scriptRef"
    },
    "clock": {
      "type": "object",
      "required": [
        "session_domain",
        "units"
      ],
      "properties": {
        "session_domain": {
          "type": "string"
        },
        "units": {
          "const": "ns"
        }
      },
      "additionalProperties": true
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "exposure_lock": {
      "type": "object",
      "properties": {
        "iso": {
          "type": "number"
        },
        "exposure_ns": {
          "type": "integer"
        },
        "wb_gains": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "lens_pos": {
          "type": "number"
        },
        "locked_at_ns": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "coord_conventions": {
      "type": "object",
      "properties": {
        "camera": {
          "const": "opencv"
        },
        "pose": {
          "const": "world-to-camera"
        },
        "units": {
          "const": "m"
        },
        "pixel_center": {
          "type": "string"
        },
        "matrix_layout": {
          "const": "row-major-16"
        },
        "quaternion": {
          "const": "xyzw"
        }
      },
      "additionalProperties": true
    },
    "consent": {
      "type": "object",
      "properties": {
        "collected_at": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cloud_families": {
          "description": "Method families the person allows to run off the local machine; `*` means all families.",
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "*"
              },
              {
                "$ref": "defs.schema.json#/$defs/recordType"
              }
            ]
          },
          "uniqueItems": true
        },
        "voice": {
          "type": "boolean"
        },
        "expires": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "qc": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "tier": {
      "enum": [
        "archival",
        "standard",
        "minimal"
      ]
    },
    "scriptRef": {
      "type": "object",
      "required": [
        "id",
        "version",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/scriptKind"
        }
      },
      "additionalProperties": true
    },
    "scriptKind": {
      "enum": [
        "full",
        "gap-fill",
        "expression-topup",
        "voice-topup",
        "lighting-variety",
        "refresh"
      ]
    },
    "toSession": {
      "type": "object",
      "required": [
        "offset_ns",
        "drift_ppm",
        "method",
        "residual_ns"
      ],
      "properties": {
        "offset_ns": {
          "type": "integer"
        },
        "drift_ppm": {
          "type": "number"
        },
        "method": {
          "type": "string"
        },
        "residual_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "required": [
        "id",
        "role",
        "clock"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^d[0-9]+$"
        },
        "model": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "satellite"
          ]
        },
        "placement": {
          "type": "string"
        },
        "clock": {
          "type": "object",
          "required": [
            "domain",
            "to_session"
          ],
          "properties": {
            "domain": {
              "type": "string"
            },
            "to_session": {
              "$ref": "#/$defs/toSession"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "stream": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^d[0-9]+/[a-z0-9._-]+$"
        },
        "kind": {
          "enum": [
            "video",
            "depth",
            "tracking",
            "motion",
            "audio",
            "stills"
          ]
        },
        "codec": {
          "enum": [
            "prores-raw",
            "prores-422hq",
            "hevc-main10",
            "hevc-main"
          ]
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "fps_nominal": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "object",
          "properties": {
            "space": {
              "enum": [
                "camera-raw",
                "appleLog2",
                "hlg-bt2020",
                "p3-d65",
                "srgb"
              ]
            },
            "bit_depth": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "dtype": {
          "enum": [
            "float16",
            "float32"
          ]
        },
        "native_kind": {
          "enum": [
            "depth",
            "disparity"
          ]
        },
        "units": {
          "enum": [
            "m",
            "1/m"
          ]
        },
        "filtered": {
          "type": "boolean"
        },
        "rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "format": {
          "enum": [
            "dng-jxl",
            "heic10"
          ]
        }
      },
      "additionalProperties": true
    },
    "phase": {
      "type": "object",
      "required": [
        "id",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "avf",
            "arkit",
            "rear"
          ]
        },
        "started_ns": {
          "type": "integer"
        },
        "ended_ns": {
          "type": "integer"
        },
        "optional": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
