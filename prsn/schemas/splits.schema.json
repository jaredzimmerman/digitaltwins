{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jaredzimmerman/digitaltwins/prsn/schemas/splits.schema.json",
  "title": ".prsncap splits.json",
  "description": "Held-out frames fixed at capture time by the seeded-stride rule (spec/prsncap.md section 5).",
  "type": "object",
  "required": ["version", "method", "seed", "stride", "stills_stride", "holdout"],
  "properties": {
    "version": {"const": 1},
    "method": {"const": "seeded-stride"},
    "seed": {"type": "integer", "minimum": 0},
    "stride": {"type": "integer", "minimum": 1},
    "stills_stride": {"type": "integer", "minimum": 1},
    "holdout": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stream", "frames"],
        "properties": {
          "stream": {"type": "string", "pattern": "^d[0-9]+/[a-z0-9._-]+$"},
          "phase": {"type": "string", "minLength": 1},
          "frames": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
