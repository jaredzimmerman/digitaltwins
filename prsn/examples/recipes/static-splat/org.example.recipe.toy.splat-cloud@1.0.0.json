{
 "id": "org.example.recipe.toy.splat-cloud",
 "version": "1.0.0",
 "family": "org.prsn.method.static-splat",
 "rank": 30,
 "produces": {
  "type": "org.example.toy.static-splat",
  "path_template": "toy/static-splat-{look}.bin"
 },
 "requires": {
  "all": [
   "rgb.*",
   "depth.truedepth"
  ],
  "any": [
   "tracking.arkit-face",
   "landmarks.any"
  ],
  "min_captures": 1
 },
 "needs": {
  "compute": "cuda",
  "ram_gb": 40,
  "disk_gb": 1,
  "est_minutes": 15
 },
 "models": [],
 "deps": [
  {
   "family": "org.prsn.method.masks",
   "role": "masks",
   "min_rank": 10
  }
 ],
 "params_default": {
  "iterations": 30000,
  "seed": 1
 },
 "determinism": "seeded-nonbitwise",
 "eval": {
  "metric": "psnr",
  "higher_is_better": true,
  "min_improvement": 0.3,
  "no_regression_per_capture": 0.5
 },
 "executor": {
  "kind": "engine",
  "entry": "example.recipes.toy:run"
 },
 "license_constraints": [],
 "select": {
  "streams": [
   "d0/rgb.front",
   "d0/depth.front"
  ],
  "phases": [
   "orbit",
   "face"
  ],
  "exclude_split": "holdout"
 },
 "local_infeasible_reason": "toy: pretend the trainer is CUDA-only",
 "return_local_trigger": "toy: a Metal port of the trainer lands"
}
